local function InLockList(p)
    for _, x in ipairs(Config.LockedPlayers) do if x == p then return true end end
    return false
end
local function InESPList(p)
    for _, x in ipairs(Config.ESPTargets) do if x == p then return true end end
    return false
end
local function ToggleList(list, p)
    for i, x in ipairs(list) do
        if x == p then table.remove(list, i) return true end
    end
    table.insert(list, p)
    return false
end

local function ApplyESPTo(p)
    if not p.Character then return end
    local shouldHave = Config.ESP and InESPList(p)
    local hl = p.Character:FindFirstChild("ShivESP")
    if shouldHave and not hl then
        local h = Instance.new("Highlight")
        h.Name = "ShivESP"
        h.FillColor = Config.ESPColor
        h.FillTransparency = 0.5
        h.OutlineColor = Color3.fromRGB(255, 255, 255)
        h.Parent = p.Character
    elseif not shouldHave and hl then
        hl:Destroy()
    end
end

local function RefreshAllESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then ApplyESPTo(p) end
    end
end

local function PanicStop()
    Config.AutoKill = false
    Config.ESP = false
    Config.FastReload = false
    Config.Fly = false
    Config.LockedPlayers = {}
    Config.ESPTargets = {}
    Config.LockActive = false
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            local hl = p.Character:FindFirstChild("ShivESP")
            if hl then hl:Destroy() end
        end
    end
    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            for _, v in ipairs(hrp:GetChildren()) do
                if v:IsA("BodyVelocity") or v:IsA("BodyGyro") then v:Destroy() end
            end
        end
    end
    if _G.ShivRefreshUI then _G.ShivRefreshUI() end
end

